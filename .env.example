# Token uzytkownika Facebooka; wymagane uprawnienia: instagram_basic oraz
# pages_read_engagement lub pages_show_list.
IG_ACCESS_TOKEN=

# Liczbowe ID profesjonalnego konta Instagram polaczonego ze strona na Facebooku.
IG_USER_ID=

# Wklej adres profilu klubu, np. https://www.instagram.com/nazwa_klubu/
IG_PROFILE_URL=

# W razie potrzeby zmien wersje Instagram Graph API.
IG_GRAPH_VERSION=v25.0

# Opcjonalna zmiana portu serwera.
# PORT=4173